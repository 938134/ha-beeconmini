  "services": {
    "kick_client": {
      "name": "剔除终端",
      "description": "按 MAC 地址剔除无线终端（厂商原生，一次性断连）。",
      "fields": {
        "mac": {
          "name": "MAC 地址",
          "description": "目标终端 MAC，示例 aa:bb:cc:dd:ee:ff"
        }
      }
    },
    "reboot_aps": {
      "name": "重启纳管 AP",
      "description": "不填 hour/minute 为立即重启；填了则写入定时重启计划。",
      "fields": {
        "hour": {
          "name": "小时",
          "description": "留空=立即重启；0-23"
        },
        "minute": {
          "name": "分钟",
          "description": "留空=立即重启；0-59"
        },
        "day": {
          "name": "重启日",
          "description": "1-7=周一至周日，8=每天"
        },
        "enabled": {
          "name": "启用定时",
          "description": "仅定时重启时生效"
        }
      }
    }
