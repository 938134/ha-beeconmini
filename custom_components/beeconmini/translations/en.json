{
  "config": {
    "step": {
      "user": {
        "title": "Connect to BeeconMini AC",
        "description": "Enter the BeeconMini router running the AC plugin (iStoreOS + beeconmini2).",
        "data": {
          "host": "Host (IP or domain, may include https://)",
          "username": "Username",
          "password": "Password",
          "verify_ssl": "Verify SSL certificate (disable for self-signed)"
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid username or password",
      "cannot_connect": "Cannot reach the router, check address and network",
      "unknown": "Unknown error, see logs"
    },
    "abort": {
      "already_configured": "This router is already configured"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "BeeconMini AC options",
        "data": {
          "scan_interval": "Poll interval (seconds)",
          "verify_ssl": "Verify SSL certificate"
        }
      }
    }
  },
  "entity": {
    "sensor": {
      "cpu_temp": {
        "name": "CPU temperature"
      },
      "cpu_usage": {
        "name": "CPU usage"
      },
      "mem_usage": {
        "name": "Memory usage"
      },
      "conn_num": {
        "name": "Connections"
      },
      "client_count": {
        "name": "Clients"
      },
      "wan_rx": {
        "name": "WAN received"
      },
      "wan_tx": {
        "name": "WAN sent"
      },
      "ap_status": {
        "name": "AP status"
      }
    },
    "binary_sensor": {
      "ap_online": {
        "name": "Online"
      }
    }
  },
  "services": {
    "kick_client": {
      "name": "Kick client",
      "description": "Kick a wireless client by MAC address.",
      "fields": {
        "mac": {
          "name": "MAC address",
          "description": "Target client MAC, e.g. aa:bb:cc:dd:ee:ff"
        }
      }
    },
    "reboot_aps": {
      "name": "Reboot managed APs",
      "description": "Omit hour/minute to reboot ALL managed APs now (real firmware channel; the AC itself does not reboot, APs rejoin after ~40-110s). Provide them to write a reboot schedule - note the firmware never executes it.",
      "fields": {
        "hour": {
          "name": "Hour",
          "description": "Omit for immediate reboot; 0-23"
        },
        "minute": {
          "name": "Minute",
          "description": "Omit for immediate reboot; 0-59"
        },
        "day": {
          "name": "Day",
          "description": "1-7 = Mon-Sun, 8 = daily"
        },
        "enabled": {
          "name": "Enable schedule",
          "description": "Only for scheduled reboot"
        }
      }
    },
    "reboot_ap": {
      "name": "Reboot one AP",
      "description": "Reboot only the specified AP; other APs and the AC are untouched (vendor cocmd channel, target selected by MAC).",
      "fields": {
        "mac": {
          "name": "AP MAC",
          "description": "Target AP MAC, e.g. aa:bb:cc:dd:ee:ff (or use name)"
        },
        "name": {
          "name": "AP name",
          "description": "Target AP display name (or use mac)"
        }
      }
    },
    "run_ap_command": {
      "name": "Run command on one AP",
      "description": "⚠️ Troubleshooting: run a shell command as root on the specified AP. Output goes to the HA log and a beeconmini_ap_command_result event.",
      "fields": {
        "mac": {
          "name": "AP MAC",
          "description": "Target AP MAC (or use name)"
        },
        "name": {
          "name": "AP name",
          "description": "Target AP display name (or use mac)"
        },
        "command": {
          "name": "Command",
          "description": "Single-line shell to run on that AP, e.g. logread | tail -30"
        }
      }
    }
  },
